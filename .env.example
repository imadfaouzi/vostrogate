# Docker Compose deployment secrets. COPY TO .env and change every placeholder.
MYSQL_ROOT_PASSWORD=REPLACE_WITH_UNIQUE_LONG_RANDOM_ROOT_PASSWORD
MYSQL_DATABASE=vostrogate
MYSQL_USER=vostrogate
MYSQL_PASSWORD=REPLACE_WITH_UNIQUE_LONG_RANDOM_APP_PASSWORD
VOSTROGATE_SETUP_TOKEN=REPLACE_WITH_RANDOM_32_PLUS_CHARACTER_SETUP_TOKEN
# Local HTTP only. Set true when you serve through HTTPS.
COOKIE_SECURE=false
APP_ENV=development

# init-config.sh appends your host UID/GID for the protected config bind mount.
