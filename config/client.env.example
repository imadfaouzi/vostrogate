# Server-side configuration, mounted at /config/client.env in the api container.
# DB_PASSWORD must match MYSQL_PASSWORD in the deployment .env file.
DB_HOST=mysql
DB_PORT=3306
DB_NAME=vostrogate
DB_USER=vostrogate
DB_PASSWORD=REPLACE_WITH_UNIQUE_LONG_RANDOM_APP_PASSWORD
# Optional: require TLS if connecting to a managed MySQL service (test cert trust).
DB_TLS=false
# Integrations can be added here later (SMTP_*, external service secrets, etc.).
